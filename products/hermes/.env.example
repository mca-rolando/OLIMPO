# HermesDDNS 26.08-02
HERMES_LISTEN=:8080
HERMES_DATABASE=/opt/hermesddns/data/hermes.db
HERMES_DOMAINS=ddns.example.com
HERMES_PARENT_NS=ns.example.com
HERMES_DEFAULT_TTL=300
HERMES_ALLOW_WILDCARD=false
HERMES_DNS_SERVER=127.0.0.1
HERMES_NSUPDATE_BINARY=/usr/bin/nsupdate
HERMES_TRUST_PROXY_HEADERS=false
HERMES_AUTOCREATE_POLICY=device-prefix
HERMES_ALLOW_INSECURE_ADMIN=false

# Generate with: htpasswd -nbB admin 'CHANGE-ME'
# In .env, wrap the entire value in single quotes so '$' characters stay literal.
# Example: HERMES_ADMIN_LOGIN='admin:$2y$05$...'
HERMES_ADMIN_LOGIN=

# Optional: fixed IP for initial zone apex if outbound discovery is unavailable.
HERMES_PUBLIC_IP=

# Future hardened mode: TSIG key file for nsupdate.
HERMES_TSIG_KEY_FILE=
